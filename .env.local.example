# Copy to .env.local and fill in real values. Never commit .env.local.

# Canonical base URL (sitemap, robots, structured data, OG)
Endpoint=https://www.vistaheredia.com

# Resend (https://resend.com) API key used to send form notification emails.
RESEND_API_KEY=

# Verified sender identity in Resend, e.g. "VISTAH Heredia <notifications@vistaheredia.com>"
EMAIL_FROM=VISTAH Heredia <onboarding@resend.dev>

# Comma-separated recipient lists. Each falls back to the matching address in
# lib/content/site.ts (email / salesEmail / careersEmail) if unset.
CONTACT_TO_EMAILS=hello@vistaheredia.com
SALES_TO_EMAILS=sales@vistaheredia.com
CAREERS_TO_EMAILS=careers@vistaheredia.com
